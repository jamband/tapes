    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "the-new-css-reset": "1.11.3",
